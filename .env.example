APP_ENV=development

# Authentication
# IMPORTANT: Set this to a long random string (e.g. run: python -c "import secrets; print(secrets.token_hex(32))")
# If not set, a temporary key is used each restart (users will be logged out on restart)
JWT_SECRET_KEY=

# Database
DATABASE_URL=sqlite:///./data/phishshield.db

# CORS – set to your frontend dev server origin
FRONTEND_ORIGIN=http://localhost:5173

# Upload limits
MAX_APK_MB=100
MAX_IMAGE_MB=10

# Privacy and retention defaults
RETAIN_UPLOADS=false
STORE_FULL_SMS_TEXT=false
STORE_THUMBNAILS=false

# External reputation lookups (disabled by default to protect privacy)
ENABLE_EXTERNAL_LOOKUPS=false
GOOGLE_SAFE_BROWSING_API_KEY=
URLHAUS_AUTH_KEY=
PHISHTANK_APP_KEY=
OPENPHISH_FEED_URL=

# Feed freshness threshold
FEED_MAX_AGE_HOURS=24

# Timeouts
REPUTATION_TIMEOUT_SECONDS=4

# OCR
# Set to path of tesseract binary if installed, e.g. C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
OCR_LANGS=eng+hin

# Rate limiting
RATE_LIMIT_PER_MINUTE=30

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/phishshield.log
